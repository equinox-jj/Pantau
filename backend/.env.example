# Copy to .env and fill in. docker compose -f docker-compose.dev.yml reads this file.

# App
APP_NAME=pantau
APP_ENV=development
APP_PORT=8080
# Comma-separated reverse proxy IPs/CIDRs whose X-Forwarded-For is trusted for
# the client IP (rate limits). Leave empty when clients connect directly.
# Required by docker-compose.prod.yml (Traefik's network CIDR).
TRUSTED_PROXIES=
LOG_LEVEL=INFO

# PostgreSQL (PostGIS)
# Host port docker compose publishes the database on (127.0.0.1 only); 5433 so
# it does not clash with a locally installed Postgres.
POSTGRES_PORT=5433
# The owner: docker compose creates the database with it and migrations run as
# it, so it must be able to create extensions, types and tables.
DB_NAME=pantau
DB_USER=pantau
DB_PASSWORD=change_me

# The API's own role (created by pantau-db-init in docker compose): it can read
# and write rows but not change the schema. Use URL-safe characters
# (openssl rand -hex 24).
DB_APP_USER=pantau_app
DB_APP_PASSWORD=change_me_app

# Used when running the API from your machine, as the owner (docker compose
# points the api container at pantau-db and DB_APP_USER instead). Set DB_PORT
# to POSTGRES_PORT to use the compose database.
DB_HOST=localhost
DB_PORT=5433
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

MIGRATION_ENABLED=true
GORM_SHOW_SQL=true

# Uploads (report photos and avatars)
UPLOAD_ENABLED=true
UPLOAD_MAX_FILE_SIZE=5MB
UPLOAD_MAX_REQUEST_SIZE=21MB

# JWT authentication: at least 32 bytes, no whitespace
# (generate one with: openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_bytes
JWT_EXPIRATION=168h

# MinIO
# Host ports docker compose publishes MinIO on (127.0.0.1 only).
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Root credentials: used only by minio-init (docker compose), never by the API
# in production.
MINIO_ROOT_USER=pantau_minio
MINIO_ROOT_PASSWORD=change_me_min_8_chars
# The API's own MinIO user, limited to MINIO_BUCKET; minio-init creates it.
# Required in production; elsewhere the API falls back to the root credentials
# when unset. Secret key: at least 8 characters.
MINIO_ACCESS_KEY=pantau-api
MINIO_SECRET_KEY=change_me_min_8_chars
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
# Bucket for report photos and avatars. minio-init creates it and makes its
# objects publicly readable (not listable); the API only checks it exists.
MINIO_BUCKET=pantau
# Base URL clients load images from. Android emulator: http://10.0.2.2:9000
MINIO_PUBLIC_URL=http://localhost:9000
