APP_PORT=8080
APP_NAME=pantau
APP_ENV=development

# docker compose overrides DB_HOST and MINIO_ENDPOINT for the api container
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pantau
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

MIGRATION_ENABLED=true
GORM_SHOW_SQL=true

UPLOAD_ENABLED=true
UPLOAD_MAX_FILE_SIZE=5MB
UPLOAD_MAX_REQUEST_SIZE=21MB

LOG_LEVEL=INFO

JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_bytes
JWT_EXPIRATION=168h

MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=pantau_minio
MINIO_ROOT_PASSWORD=replace_with_a_minio_secret_of_at_least_8_chars
MINIO_USE_SSL=false
MINIO_BUCKET=pantau
# Base URL clients use to load images. Android emulator: http://10.0.2.2:9000
MINIO_PUBLIC_URL=http://localhost:9000
